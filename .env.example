# ArchAI Environment Configuration Template

APP_ENV=development
DEBUG=true
DEMO_MODE=true

# Security & Session
SECRET_KEY=archai-super-secret-production-encryption-key-change-in-prod-12345
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database
# For SQLite local running:
DATABASE_URL=sqlite:///./archai.db
# For PostgreSQL Production:
# DATABASE_URL=postgresql://archai:archai_secure_pass@localhost:5432/archai

# Redis Cache & Broker
REDIS_URL=redis://localhost:6379/0

# AI Provider Configuration
LLM_PROVIDER=huggingface
LLM_MODEL=gemini-1.5-pro
GEMINI_API_KEY=
OPENAI_API_KEY=
HUGGINGFACE_API_KEY=

# CORS
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000", "http://localhost:8000"]
