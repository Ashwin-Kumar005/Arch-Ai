{
  "name": "archai-workspace",
  "version": "1.0.0",
  "description": "ArchAI - Autonomous AI Software Solution Architect Monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --prefix apps/web",
    "build:web": "npm run build --prefix apps/web",
    "start:web": "npm run start --prefix apps/web",
    "dev:api": "uvicorn app.main:app --reload --port 8000 --app-dir apps/api",
    "start:api": "uvicorn app.main:app --port 8000 --app-dir apps/api",
    "test:api": "pytest"
  }
}